# ============================================
# REQUIRED FOR VERCEL
# Copy this file to .env.local for local dev.
# Paste these exact keys into Vercel Dashboard → Settings → Environment Variables.
# ============================================

# MongoDB Atlas (Network Access → Allow from anywhere 0.0.0.0/0 OR Vercel IPs)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/innerfirstaid?retryWrites=true&w=majority

# Google Analytics 4 (Public - sent to browser)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta Pixel (Public - sent to browser)
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXX

# Stripe Payment Links (Public - sent to browser)
NEXT_PUBLIC_STRIPE_EN=https://buy.stripe.com/REPLACE_ENGLISH_LINK
NEXT_PUBLIC_STRIPE_SL_F=https://buy.stripe.com/REPLACE_SLOVENIAN_FEMALE
NEXT_PUBLIC_STRIPE_SL_M=https://buy.stripe.com/REPLACE_SLOVENIAN_MALE
